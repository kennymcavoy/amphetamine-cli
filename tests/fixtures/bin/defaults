#!/usr/bin/env bash

set -u

printf 'defaults %s\n' "$*" >> "$AMPHETAMINE_TEST_LOG"

if [ "$#" -ne 3 ] || [ "$1" != read ] ||
   [ "$2" != com.if.Amphetamine ] || [ "$3" != 'Allow Display Sleep' ]; then
  printf 'fake defaults: unexpected arguments\n' >&2
  exit 64
fi

printf '%s\n' "${FAKE_DISPLAY_PREF:-1}"
