#!/usr/bin/env bash

set -u

if [ "$#" -ne 2 ] || [ "$1" != -e ]; then
  printf 'fake osascript: expected -e SCRIPT\n' >&2
  exit 64
fi

script=$2
printf '%s\n---\n' "$script" >> "$AMPHETAMINE_TEST_LOG"

if [ -n "${FAKE_OSASCRIPT_FAIL_MATCH:-}" ]; then
  case "$script" in
    *"$FAKE_OSASCRIPT_FAIL_MATCH"*)
      printf 'fake osascript failure\n' >&2
      exit 1
      ;;
  esac
fi

case "$script" in
  *'set activeState to session is active'*)
    printf '%b\n' "${FAKE_STATUS:-true\t9000\ttrue\ttrue\tfalse}"
    ;;
  *'if session is active then'*'allow display sleep'*)
    if [ "${FAKE_DISPLAY_ACTIVE:-true}" = true ]; then
      printf 'allow display sleep\n' >> "$AMPHETAMINE_TEST_EFFECT_LOG"
      printf 'changed\n'
    else
      printf 'inactive\n'
    fi
    ;;
  *'if session is active then'*'prevent display sleep'*)
    if [ "${FAKE_DISPLAY_ACTIVE:-true}" = true ]; then
      printf 'prevent display sleep\n' >> "$AMPHETAMINE_TEST_EFFECT_LOG"
      printf 'changed\n'
    else
      printf 'inactive\n'
    fi
    ;;
  *'to session is active')
    printf '%s\n' "${FAKE_ACTIVE:-true}"
    ;;
  *'to allow display sleep')
    if [ "${FAKE_EXPIRE_BEFORE_DISPLAY_ACTION:-false}" = true ]; then
      printf 'global preference write\n' >> "$AMPHETAMINE_TEST_EFFECT_LOG"
    else
      printf 'allow display sleep\n' >> "$AMPHETAMINE_TEST_EFFECT_LOG"
    fi
    ;;
  *'to prevent display sleep')
    if [ "${FAKE_EXPIRE_BEFORE_DISPLAY_ACTION:-false}" = true ]; then
      printf 'global preference write\n' >> "$AMPHETAMINE_TEST_EFFECT_LOG"
    else
      printf 'prevent display sleep\n' >> "$AMPHETAMINE_TEST_EFFECT_LOG"
    fi
    ;;
esac
